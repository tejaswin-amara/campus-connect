							"script": {
								"exec": [
									"pm.test('Status code is 201 Created or 409 Conflict (idempotent)', function () {",
									"    pm.expect([201, 409]).to.include(pm.response.code);",
									"});",
									"if (pm.response.code === 201) {",
									"    const json = pm.response.json();",
									"    pm.test('Response contains valid user summary', function () {",
									"        pm.expect(json).to.have.property('id');",
									"        pm.expect(json.username).to.eql(pm.collectionVariables.get('studentUsername'));",
									"        pm.expect(json.role).to.eql('ROLE_STUDENT');",
