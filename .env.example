# CampusConnect Environment Configuration
# Copy this template to .env and replace placeholder values with environment-specific secrets.

# Spring Profile Configuration
SPRING_PROFILES_ACTIVE=prod

# Server Port & Binding (Defaults to port 8080)
PORT=8080
APP_BIND_ADDRESS=127.0.0.1

# Cross-Origin Resource Sharing (CORS) Mappings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Database Configuration (MySQL 8.0)
MYSQLDATABASE=campus_events
MYSQLUSER=campus_app
MYSQLPASSWORD=replace-with-a-secure-user-password
MYSQL_ROOT_PASSWORD=replace-with-a-secure-root-password
MYSQL_LOCAL_PORT=3306
MYSQL_USE_SSL=false
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/campus_events?allowPublicKeyRetrieval=true&useSSL=false&connectTimeout=10000

# Application Security & Operations
ADMIN_PASSWORD=replace-with-a-secure-admin-password
COOKIE_SECURE=false
DDL_AUTO=validate
LOG_LEVEL=INFO
HEALTH_SHOW_DETAILS=never
