{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinDigests"
  ],
  "packageRules": [
    {
      "matchPackagePatterns": ["^org.springframework"],
      "groupName": "spring"
    },
    {
      "matchPackagePatterns": ["^react", "^@types/react"],
      "groupName": "react"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "vulnerabilityAlerts": {
    "enabled": true
  }
}
